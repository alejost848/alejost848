{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "dist",
    "redirects": [
      {
        "source": "/robots",
        "destination": "/robots.txt",
        "type": 301
      },
      {
        "source": "/sitemap",
        "destination": "/sitemap.xml",
        "type": 301
      }
    ],
    "rewrites": [{
        "source": "/submitForm",
        "function": "handleFormSubmit"
      },
      {
        "source": "**/!(*.*)",
        "function": "host"
      }
    ],
    "headers": [{
      "source": "**/*.@(jpg|jpeg|gif|png)",
      "headers": [{
        "key": "Cache-Control",
        "value": "max-age=86400"
      }]
    }]
  }
}
