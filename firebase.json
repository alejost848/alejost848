{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {},
  "hosting": {
    "public": "dist",
    "redirects": [
      {
        "source": "/robots",
        "destination": "/robots.txt",
        "type": 301
      },
      {
        "source": "/sitemap",
        "destination": "/sitemap.xml",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/submitForm",
        "function": { "functionId": "handleFormSubmit", "region": "us-central1" }
      },
      {
        "source": "/work/**",
        "function": { "functionId": "host", "region": "us-central1" }
      },
      {
        "source": "/tutorial/**",
        "function": { "functionId": "host", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|svg|ico)",
        "headers": [{
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }]
      },
      {
        "source": "/@(sw.js|registerSW.js|manifest.webmanifest)",
        "headers": [{
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }]
      }
    ]
  }
}
