{
  "rules": {
    ".read": "auth.uid === 'd9JhyoWr4LWRviqzQG7Sdzm0PZo2'",
    ".write": "auth.uid === 'd9JhyoWr4LWRviqzQG7Sdzm0PZo2'",
    "dashboard": {
      "autocompleteSuggestions": {
        ".read": true
      }
    },
    "home": {
      ".read": true,
      "latestTutorials": {
        ".indexOn": "publishedDate"
      }
    },
    "tutorials": {
      ".read": true,
      "$sid": {
        "videos": {
          ".indexOn": ["publishedDate", "slug"]
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "theme": {
          ".validate": "newData.isString() && (newData.val() === 'dark' || newData.val() === 'light' || newData.val() === 'auto')"
        },
        "subscribed": {
          ".validate": "newData.isBoolean()"
        },
        "token": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "works": {
      ".read": true,
      ".indexOn": ["publishedDate"]
    }
  }
}
